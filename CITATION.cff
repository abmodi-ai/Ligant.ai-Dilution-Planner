    given-names: A.B.
    affiliation: Ligant AI Incorporated
version: v1.1.1
date-released: '2026-09-24'
license: Apache-2.0
repository-code: https://github.com/abmodi-ai/Ligant.ai-Dilution-Planner
url: https://benchtools.ligant.ai/dilution-planner/
keywords:
  - dilution
  - serial dilution
  - intermediate dilution
  - pipetting
  - laboratory calculator
  - reproducible research
